# Copiar como .env.local y completar con los datos del proyecto de Supabase
# (Supabase → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave con permisos totales. SOLO en el servidor (Vercel → Environment Variables).
# Nunca la subas a GitHub ni la pongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
