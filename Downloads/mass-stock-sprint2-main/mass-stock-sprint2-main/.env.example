# Copiar como .env.local y completar con los datos del proyecto de Supabase
# (Supabase → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave con permisos totales. SOLO en el servidor (Vercel → Environment Variables).
# Nunca la subas a GitHub ni la pongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...


# Aliases
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable...


# Configuración de Correo Electrónico Institucional (Nodemailer / Gmail SMTP)
# 100% Gratuito y sin necesidad de dominio propio.
# Para Gmail: genera una "Contraseña de Aplicación" de 16 caracteres en myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx clave del correo
EMAIL_FROM="Tiendas Mass" <correo@gmail.com>

# Opcional: si dispones de dominio propio verificado en Resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
